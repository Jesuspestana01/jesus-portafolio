---
import "../styles/global.css";
import "aos/dist/aos.css";
import Welcome from "../components/Welcome.astro"
import Contact from "../components/Contact.astro"
import { Navbar } from "../components/Navbar";
import { Stacks } from "../components/Stacks.tsx"
import { InfoCard } from "../components/InfoCard";
import { Projects } from "../components/Projects"
import { Footer } from "../components/Footer"
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Portafolio</title>
	</head>
	<body
		class="bg-pattern bg-linear-to-r/decreasing from-indigo-500 to-teal-400 text-white"
	>
		<Navbar client:load />
		<main id="top" class="flex flex-col items-center justify-center">
			<section id="about-me">
				<Welcome/>
			</section>
			<section id="stacks">
				<Stacks client:load/>
			</section>
			<section id="cards">
				<InfoCard client:load/>
			</section>
			<section id="projects" class="py-20 px-4 mt-20">
				<Projects client:load/>
			</section>
			<section id="contact" class="py-20 px-4 mt-20" style="width: 80rem;">
				<Contact/>
			</section>
			<Footer/>
		</main>
	</body>
	<script>
  import AOS from 'aos';

  const initAOS = () => {
    AOS.init({
      duration: 800,
    });
  };
  initAOS();
  document.addEventListener('astro:after-swap', initAOS);
</script>
</html>
