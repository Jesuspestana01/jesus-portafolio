---
import "../styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Message Sent | Jesús Pestaña</title>
    </head>
    <body class="bg-neutral-950 text-white flex items-center justify-center min-h-screen px-4">
        <main class="text-center space-y-6">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-500/10 border border-emerald-500/20 mb-4">
                <svg class="w-10 h-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h1 class="text-4xl font-bold tracking-tight">Message Sent!</h1>
            <p class="text-zinc-400 max-w-sm mx-auto">
                Thanks for reaching out. I'll get back to you as soon as possible.
            </p>
            <div class="pt-6">
                <a 
                    href="/" 
                    class="px-8 py-3 bg-emerald-500/10 border border-emerald-500/30 rounded-full text-emerald-400 text-sm font-bold uppercase tracking-widest hover:bg-emerald-500/20 transition-all"
                >
                    ← Back to Portfolio
                </a>
            </div>
        </main>
    </body>
</html>