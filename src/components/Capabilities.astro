---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { capabilitiesInfo } from "../data/capabilitiesInfo";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="capabilities" class="max-w-5xl mx-auto px-6 md:px-10">
  <div class="border-t border-[var(--border)] py-16 md:py-24 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-3 reveal">
      <div class="md:sticky md:top-24">
        <span class="font-mono text-xs tracking-[0.15em] text-[var(--accent)]">03</span>
        <h2 class="mt-2 font-serif text-3xl text-[var(--ink)] tracking-tight">
          {t("section.capabilities.title")}
        </h2>
        <p class="mt-2 text-sm text-[var(--ink-muted)] leading-relaxed">
          {t("section.capabilities.subtitle")}
        </p>
      </div>
    </div>

    <div class="md:col-span-9 reveal">
      <div class="grid grid-cols-1 sm:grid-cols-2 border border-[var(--border)] rounded-lg overflow-hidden bg-[var(--border)] gap-px">
        {capabilitiesInfo.map((group) => (
          <div class="bg-[var(--bg)] p-6 md:p-7 flex flex-col justify-between gap-5">
            <div>
              <span class="font-mono text-[11px] tracking-[0.14em] text-[var(--accent)]">
                {group.index}
              </span>
              <h3 class="mt-2 font-medium text-lg text-[var(--ink)] tracking-tight">
                {group.title[lang]}
              </h3>
              <p class="mt-2 text-sm text-[var(--ink-secondary)] leading-relaxed">
                {group.description[lang]}
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <span class="font-mono text-[11px] px-2.5 py-1 rounded bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--ink-secondary)]">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
