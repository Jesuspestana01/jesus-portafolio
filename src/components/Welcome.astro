---
const { t } = Astro.props;
---

<h1 class="text-center font-black text-4xl md:text-7xl text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-700 dark:from-emerald-400 dark:to-teal-500">
    {t('hero.title')}
</h1>

<h2 class="text-center py-4 text-2xl md:text-4xl font-bold font-mono text-[#0F2625] dark:text-white">
    {t('hero.subtitle')}
</h2>

<p class="text-lg md:text-xl max-w-2xl mx-auto text-center text-gray-600 dark:text-gray-400">
    {t('hero.desc')}
</p>

<p class="mt-5 text-base md:text-lg max-w-2xl mx-auto text-center text-gray-500 dark:text-gray-500">
    {t('hero.desc2')}
</p>