---
import { Image } from "astro:assets";
import tsLogo from "../assets/ts-logo.png";
import reactLogo from "../assets/react-logo.png";
import postgresqlLogo from "../assets/postgresql-logo.png";
import expressjsLogo from "../assets/expressjs-logo.png";
---

<div class="flex flex-wrap justify-center gap-2 md:gap-3 mb-6 md:mb-8 mt-6">
    <!-- typescript -->
    <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-500/10 border border-blue-500/20 rounded-full text-blue-400 text-xs md:text-sm font-medium"
    >
        <Image
            src={tsLogo}
            height={18}
            width={18}
            alt="TypeScript logo"
            class="object-contain"
        />
        <span>TypeScript</span>
    </div>
    <!-- react -->
    <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-300/10 border border-blue-300/20 rounded-full text-blue-300 text-xs md:text-sm font-medium"
    >
        <Image
            src={reactLogo}
            height={18}
            width={18}
            alt="React logo"
            class="object-contain"
        />
        <span>React</span>
    </div>

    <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-emerald-400 text-xs md:text-sm font-medium"
    >
        <span>Node.js</span>
    </div>
    <!-- postgresql -->
    <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-sky-700/10 border border-sky-700/20 rounded-full text-sky-600 text-xs md:text-sm font-medium"
    >
        <Image
            src={postgresqlLogo}
            height={18}
            width={18}
            alt="PostgreSQL logo"
            class="object-contain"
        />
        <span>PostgreSQL</span>
    </div>
    <!-- expressjs -->
     <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-slate-600/10 border border-slate-600/20 rounded-full text-slate-500 text-xs md:text-sm font-medium"
    >
        <Image
            src={expressjsLogo}
            height={18}
            width={18}
            alt="Expressjs logo"
            class="object-contain"
        />
        <span>Express.js</span>
    </div>
</div>
