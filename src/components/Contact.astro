---
// Contact.astro
---

<div class="max-w-3xl mx-auto text-center">
    <div class="space-y-8" style="opacity: 1; transform: none;">
        <h2 class="text-3xl font-bold text-white">Let’s Connect</h2>
        <div class="flex items-center justify-center gap-2 text-gray-400">
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            <span>Caracas, Venezuela</span>
        </div>
        <div class="max-w-lg mx-auto text-left">
            <form class="space-y-6">
                <div>
                    <!-- name -->
                    <label
                        for="name"
                        class="block text-sm font-medium text-gray-300 mb-2"
                        >Name</label
                    ><input
                        type="text"
                        id="name"
                        class="border border-zinc-800 bg-[#1a1f26] focus:border-emerald-500 focus:outline-none transition-all w-full px-4 py-2 rounded-lg border border-gray-700 bg-gray-800 text-white focus:ring-2 focus:ring-blue-400 focus:border-blue-400 outline-none transition-colors"
                    />
                </div>
                <div>
                    <!-- email -->
                    <label
                        for="email"
                        class="block text-sm font-medium text-gray-300 mb-2"
                        >Email</label
                    ><input
                        type="email"
                        id="email"
                        class="border border-zinc-800 bg-[#1a1f26] focus:border-emerald-500 focus:outline-none transition-all w-full px-4 py-2 rounded-lg border border-gray-700 bg-gray-800 text-white focus:ring-2 focus:ring-blue-400 focus:border-blue-400 outline-none transition-colors"
                    />
                </div>
                <div>
                    <!-- message -->
                    <label
                        for="message"
                        class="block text-sm font-medium text-gray-300 mb-2"
                        >Message</label
                    ><textarea
                        id="message"
                        rows="4"
                        class="border border-zinc-800 bg-[#1a1f26] focus:border-emerald-500 focus:outline-none transition-all w-full px-4 py-2 rounded-lg border border-gray-700 bg-gray-800 text-white focus:ring-2 focus:ring-blue-400 focus:border-blue-400 outline-none transition-colors resize-none"
                    ></textarea>
                </div>
                <div class="flex items-center justify-center">
                    <button
                        type="button"
                        class="w-50 px-6 py-3 text-white font-medium bg-gradient-to-r from-emerald-400 to-teal-500 rounded-lg hover:scale-105 hover:shadow-md hover:brightness-110 transition-all duration-150 ease-in-out"
                        >Send Message</button
                    >
                </div>
                <div class="flex items-center justify-center mt-20">
                    <a
                        href="#"
                        class="flex items-center justify-center gap-2 w-auto px-6 py-3 text-white font-medium border border-teal-500 rounded-lg hover:scale-105 hover:shadow-md hover:brightness-110 transition-all duration-150 ease-in-out"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                            ></path>
                        </svg>

                        <span>View resume</span>
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
