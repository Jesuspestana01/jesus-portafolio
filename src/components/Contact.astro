---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { contactProfile } from "../data/contactLinks";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const successAction = `/${lang}/success`;
const cvPath = lang === "en" ? "/jesuspestana-resume-en.pdf" : "/jesuspestana-resume-es.pdf";
---

<section id="contact" class="max-w-5xl mx-auto px-6 md:px-10">
  <div class="border-t border-[var(--border)] py-16 md:py-24 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-3 reveal">
      <div class="md:sticky md:top-24">
        <span class="font-mono text-xs tracking-[0.15em] text-[var(--accent)]">04</span>
        <h2 class="mt-2 font-serif text-3xl text-[var(--ink)] tracking-tight">
          {t("section.contact.title")}
        </h2>
        <p class="mt-2 text-sm text-[var(--ink-muted)] leading-relaxed">
          {t("section.contact.subtitle")}
        </p>
      </div>
    </div>

    <div class="md:col-span-9 grid grid-cols-1 lg:grid-cols-12 gap-10 reveal">
      <div class="lg:col-span-5 space-y-6">
        <p class="text-sm md:text-[15px] text-[var(--ink-secondary)] leading-relaxed">
          {t("contact.intro")}
        </p>

        <div class="space-y-4 pt-2 border-t border-[var(--border)]">
          <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)]">
              {t("contact.direct.email")}
            </div>
            <a
              href={`mailto:${contactProfile.email}`}
              class="mt-1 inline-block text-sm font-medium text-[var(--ink)] hover:text-[var(--accent)] underline underline-offset-4 decoration-[var(--border-strong)] transition-colors"
            >
              {contactProfile.email}
            </a>
          </div>

          <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)]">
              {t("contact.direct.location")}
            </div>
            <p class="mt-1 text-sm text-[var(--ink-secondary)]">
              {t("contact.direct.location_value")}
            </p>
          </div>

          <div>
            <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)]">
              {t("contact.direct.links")}
            </div>
            <div class="mt-2 flex flex-col items-start gap-2 text-sm">
              <a
                href={contactProfile.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors"
              >
                LinkedIn <span class="font-mono text-xs" aria-hidden="true">↗</span>
              </a>
              <a
                href={contactProfile.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors"
              >
                GitHub <span class="font-mono text-xs" aria-hidden="true">↗</span>
              </a>
              <a
                href={cvPath}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors"
              >
                {t("contact.button.cv")} <span class="font-mono text-xs" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={successAction}
          class="bg-[var(--surface)] border border-[var(--border)] rounded-lg p-6 md:p-7 space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>
              Don’t fill this out if you’re human: <input name="bot-field" />
            </label>
          </p>

          <div>
            <label
              for="contact-name"
              class="block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)] mb-2"
            >
              {t("contact.label.name")}
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              placeholder={t("contact.placeholder.name")}
              class="w-full px-3.5 py-2.5 rounded-md border border-[var(--border)] bg-[var(--bg)] text-sm text-[var(--ink)] placeholder:text-[var(--ink-muted)] focus:border-[var(--accent)] focus:outline-none transition-colors"
            />
          </div>

          <div>
            <label
              for="contact-email"
              class="block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)] mb-2"
            >
              {t("contact.label.email")}
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              placeholder={t("contact.placeholder.email")}
              class="w-full px-3.5 py-2.5 rounded-md border border-[var(--border)] bg-[var(--bg)] text-sm text-[var(--ink)] placeholder:text-[var(--ink-muted)] focus:border-[var(--accent)] focus:outline-none transition-colors"
            />
          </div>

          <div>
            <label
              for="contact-message"
              class="block font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-muted)] mb-2"
            >
              {t("contact.label.message")}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder={t("contact.placeholder.message")}
              class="w-full px-3.5 py-2.5 rounded-md border border-[var(--border)] bg-[var(--bg)] text-sm text-[var(--ink)] placeholder:text-[var(--ink-muted)] focus:border-[var(--accent)] focus:outline-none transition-colors resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-5 rounded-md bg-[var(--ink)] text-[var(--bg)] text-sm font-medium hover:opacity-90 transition-opacity cursor-pointer"
          >
            {t("contact.button.send")}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
