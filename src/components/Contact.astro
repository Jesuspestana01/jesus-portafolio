---
// Contact.astro
---

<div class="w-full max-w-3xl mx-auto px-4">
    <div class="space-y-8 text-center" data-aos="fade-up">
        <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Let’s Connect</h2>
            <div class="flex items-center justify-center gap-2 text-emerald-500/80">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="text-zinc-400 font-mono text-sm uppercase tracking-widest">Caracas, Venezuela</span>
            </div>
        </div>

        <div class="max-w-lg mx-auto">
            <form class="space-y-6 text-left bg-white/5 p-6 md:p-8 rounded-2xl border border-white/5 backdrop-blur-sm">
                <div>
                    <label for="name" class="block text-xs uppercase tracking-widest font-bold text-emerald-400 mb-2">Name</label>
                    <input
                        type="text"
                        id="name"
                        placeholder="Your Name"
                        class="w-full px-4 py-3 rounded-xl border border-white/10 bg-black/20 text-white placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all"
                    />
                </div>
                <div>
                    <label for="email" class="block text-xs uppercase tracking-widest font-bold text-emerald-400 mb-2">Email</label>
                    <input
                        type="email"
                        id="email"
                        placeholder="your@email.com"
                        class="w-full px-4 py-3 rounded-xl border border-white/10 bg-black/20 text-white placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all"
                    />
                </div>
                <div>
                    <label for="message" class="block text-xs uppercase tracking-widest font-bold text-emerald-400 mb-2">Message</label>
                    <textarea
                        id="message"
                        rows="4"
                        placeholder="How can I help you?"
                        class="w-full px-4 py-3 rounded-xl border border-white/10 bg-black/20 text-white placeholder:text-zinc-600 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-all resize-none"
                    ></textarea>
                </div>

                <div class="flex flex-col gap-4 pt-4">
                    <button
                        type="button"
                        class="w-full py-4 bg-emerald-500 text-black font-bold uppercase tracking-widest rounded-xl hover:bg-emerald-400 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-all active:scale-95"
                    >
                        Send Message
                    </button>
                    
                    <a
                        href="/tu-cv.pdf" 
                        target="_blank"
                        class="flex items-center justify-center gap-2 w-full py-4 text-zinc-400 font-bold uppercase tracking-widest border border-white/10 rounded-xl hover:bg-white/5 hover:text-white transition-all"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
                        </svg>
                        View Resume
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>