---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { projectsInfo } from "../data/projectsInfo";
import ProjectDiagram from "./ProjectDiagram.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="max-w-5xl mx-auto px-6 md:px-10">
  <div class="border-t border-[var(--border)] py-16 md:py-24 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-3 reveal">
      <div class="md:sticky md:top-24">
        <span class="font-mono text-xs tracking-[0.15em] text-[var(--accent)]">02</span>
        <h2 class="mt-2 font-serif text-3xl text-[var(--ink)] tracking-tight">
          {t("section.projects.title")}
        </h2>
        <p class="mt-2 text-sm text-[var(--ink-muted)] leading-relaxed">
          {t("section.projects.subtitle")}
        </p>
      </div>
    </div>

    <div class="md:col-span-9 space-y-16">
      {projectsInfo.map((project) => (
        <article class="reveal border-b border-[var(--border)] pb-14 last:border-b-0 last:pb-0">
          <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] uppercase tracking-[0.13em] text-[var(--ink-muted)]">
            <div class="flex items-center gap-2.5">
              <span class="text-[var(--accent)]">{project.index}</span>
              <span aria-hidden="true">·</span>
              <span>{project.category[lang]}</span>
            </div>
            <span>{project.period[lang]}</span>
          </div>

          <h3 class="mt-3 font-serif text-2xl md:text-3xl text-[var(--ink)] tracking-tight">
            {project.title[lang]}
          </h3>

          <p class="mt-3 text-sm md:text-[15px] text-[var(--ink-secondary)] leading-relaxed max-w-2xl">
            {project.summary[lang]}
          </p>

          <ProjectDiagram projectId={project.id} lang={lang} />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-7">
            <div>
              <h4 class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--ink-muted)] mb-3">
                {t("projects.implementation")}
              </h4>
              <ul class="space-y-2.5">
                {project.implementation[lang].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-[var(--ink-secondary)] leading-relaxed">
                    <span class="font-mono text-xs text-[var(--ink-muted)] mt-0.5 select-none shrink-0" aria-hidden="true">
                      —
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h4 class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--ink-muted)] mb-3">
                {t("projects.outcome")}
              </h4>
              <ul class="space-y-2.5">
                {project.outcomes[lang].map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-[var(--ink-secondary)] leading-relaxed">
                    <span class="font-mono text-xs text-[var(--accent)] mt-0.5 select-none shrink-0" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-7 pt-5 border-t border-[var(--border)] flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="font-mono text-[11px] px-2.5 py-1 rounded bg-[var(--bg-subtle)] border border-[var(--border)] text-[var(--ink-secondary)]">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 text-sm font-medium shrink-0">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[var(--ink)] hover:text-[var(--accent)] underline underline-offset-4 decoration-[var(--border-strong)] hover:decoration-[var(--accent)] transition-colors"
                >
                  <span>{t("projects.view_live")}</span>
                  <span class="font-mono text-xs" aria-hidden="true">↗</span>
                </a>
              )}

              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[var(--ink)] hover:text-[var(--accent)] underline underline-offset-4 decoration-[var(--border-strong)] hover:decoration-[var(--accent)] transition-colors"
                >
                  <span>{t("projects.view_source")}</span>
                  <span class="font-mono text-xs" aria-hidden="true">↗</span>
                </a>
              )}

              {project.isPrivate && !project.liveUrl && !project.githubUrl && (
                <span class="font-mono text-xs text-[var(--ink-muted)]">
                  {t("projects.private_system")}
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
