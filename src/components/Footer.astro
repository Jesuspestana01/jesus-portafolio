---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { contactLinks } from "../data/contactLinks";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="max-w-5xl mx-auto px-6 md:px-10">
  <div class="border-t border-[var(--border)] py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono text-[var(--ink-muted)]">
    <span>{t("footer.rights")}</span>

    <div class="flex flex-wrap items-center gap-6">
      {contactLinks.map((item) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          class="hover:text-[var(--ink)] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a href="#top" class="hover:text-[var(--ink)] transition-colors">
        ↑ {t("footer.back_to_top")}
      </a>
    </div>
  </div>
</footer>
